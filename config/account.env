# Account defaults for the repo owner's account. Another account: re-run scripts/probe-gpus.sh and
# replace these, and set DRIVE_QUOTA_PROJECT to your own project (or empty). Fill these from scripts/probe-gpus.sh, and re-run the probe
# after any plan change (for example Google AI Pro to Ultra).
#
# Every value is a default: `: "${VAR:=...}"` sets it only when the environment does not
# already have it, so `GPU=L4 bash scripts/studio-up.sh ...` still works.

# Plan the signed-in account is on.
: "${PLAN:=Google AI Pro (200 units/month)}"

# GPUs the probe granted, best first.
# Eligible per ccu-info (2026-11-23): G4 A100 L4 T4; TPUs V6E1 V5E1. Not eligible: H100.
# A100 is the 40 GB model. G4 is entitled but has answered 503 (no capacity) on every try.
: "${GRANTED_GPUS:=A100 G4 L4 T4}"

# Default GPU for video and anything near or above 24 GB of weights.
: "${GPU:=A100}"

# Cheaper default for models that fit in about 22 GB (images, speech, music, 3D).
# L4 is roughly a quarter of the A100 rate; T4 is the cheapest and slowest.
: "${GPU_SMALL:=L4}"

# Do not start a GPU below this balance.
: "${MIN_BALANCE:=20}"

# Measured unit rates. `colab usage` prints a live "Usage rate" while a GPU runs;
# that is how these were measured, because the balance itself lags a few minutes.
#   A100 6.73/hr (2026-11-23, measured)
#   L4   about 1.9/hr (implied by a two-GPU rate of 8.67/hr with the A100 running)
#   T4   about 1.1 to 1.8/hr (community figures, not measured here)
#   G4   about 10/hr (the X post this repo started from, not measured here)

# Save finished outputs to Google Drive before the GPU stops (scripts/drive-save.sh).
# auto = only when DRIVE_QUOTA_PROJECT is set; 1 = always try; 0 = never.
: "${DRIVE_SAVE:=auto}"
# Drive folder that holds "outputs/<date>/<session>/".
: "${DRIVE_FOLDER:=Colab Studio}"
# The Drive API refuses this login without a quota project. Another account must use its own project.
# This is the owner's free
# Google Cloud project (display name "My Project 40836"), with the Drive API enabled.
# Empty = Drive saving is skipped.
: "${DRIVE_QUOTA_PROJECT:=green-syntax-515617-d9}"

# Export the values, so a child process (python, a script) sees them after `source`.
export PLAN GRANTED_GPUS GPU GPU_SMALL MIN_BALANCE DRIVE_SAVE DRIVE_FOLDER DRIVE_QUOTA_PROJECT
