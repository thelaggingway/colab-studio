# Account defaults. Fill these from scripts/probe-gpus.sh, and re-run the probe
# after any plan change (for example Google AI Pro to Ultra).

# Plan the signed-in account is on.
PLAN="Google AI Pro (200 units/month)"

# GPUs the probe granted, best first. Empty until the first probe.
# Eligible per ccu-info (2026-11-23): G4 A100 L4 T4; TPUs V6E1 V5E1. Not eligible: H100.
# G4 and A100 returned 503 (no capacity) in both probes; L4 was granted on a retry. Retry G4 later.
# A100 is the 40 GB model (granted 2026-11-23 while L4 was busy); about 4x the L4 unit rate.
GRANTED_GPUS="A100 L4 T4"

# Default GPU for sessions.
GPU="L4"

# Do not start a GPU below this balance.
MIN_BALANCE=20
